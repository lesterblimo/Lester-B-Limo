---
interface Props {
	eyebrow: string;
	title: string;
	intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="legal-hero">
	<div>
		<p><span></span>{eyebrow}</p>
		<h1>{title}</h1>
		<strong>Effective August 20, 2026</strong>
	</div>
</header>

<article class="legal-content">
	<p class="legal-intro">{intro}</p>
	<slot />
</article>

<style>
	.legal-hero {
		padding: clamp(8.5rem, 15vw, 11rem) 1.5rem clamp(3.5rem, 7vw, 5.5rem);
		background: #20211e;
		color: #fff;
	}

	.legal-hero > div,
	.legal-content {
		width: min(100%, 54rem);
		margin-inline: auto;
	}

	.legal-hero p {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0 0 1.1rem;
		color: #f7b817;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.legal-hero p span {
		width: 1.8rem;
		height: 1px;
		background: currentColor;
	}

	.legal-hero h1 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.legal-hero strong {
		color: rgba(255, 255, 255, 0.62);
		font-size: 0.75rem;
		font-weight: 500;
	}

	.legal-content {
		padding: clamp(3.5rem, 7vw, 6rem) 1.5rem;
	}

	.legal-intro {
		padding-bottom: 2rem;
		margin: 0 0 2.5rem;
		border-bottom: 1px solid var(--line);
		color: #3f413d;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.8rem);
		line-height: 1.55;
	}

	.legal-content :global(section + section) {
		margin-top: 2.75rem;
	}

	.legal-content :global(h2) {
		margin: 0 0 0.8rem;
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 3vw, 2.25rem);
		font-weight: 400;
		line-height: 1.2;
	}

	.legal-content :global(p),
	.legal-content :global(li) {
		color: var(--slate);
		line-height: 1.8;
	}

	.legal-content :global(p) {
		margin: 0;
	}

	.legal-content :global(ul) {
		padding-left: 1.25rem;
		margin: 0;
	}

	.legal-content :global(a) {
		color: #76570b;
		font-weight: 700;
	}
</style>
