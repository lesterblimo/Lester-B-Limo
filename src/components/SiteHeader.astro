---
import { PRIMARY_NAVIGATION, SITE, normalizePath } from '../config/site';

interface Props {
	variant?: 'overlay' | 'solid';
}

const { variant = 'overlay' } = Astro.props;
const currentPath = normalizePath(Astro.url.pathname);
const exactItem = PRIMARY_NAVIGATION.find((item) => normalizePath(item.href) === currentPath);
const branchHref = exactItem
	? undefined
	: PRIMARY_NAVIGATION
			.map((item) => normalizePath(item.href))
			.filter((href) => href !== '/' && currentPath.startsWith(href))
			.sort((a, b) => b.length - a.length)[0];

const navigation = PRIMARY_NAVIGATION.map((item) => {
	const normalizedHref = normalizePath(item.href);
	const isExact = normalizedHref === currentPath;
	return {
		...item,
		isExact,
		isActive: isExact || normalizedHref === branchHref,
	};
});
---

<header class:list={['site-header', `site-header--${variant}`]} data-site-header>
	<div class="nav-shell">
		<a class="brand" href="/" aria-label={`${SITE.name} home`}>
			<img src={SITE.logo} alt={SITE.name} width="720" height="240" />
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<ul>
				{navigation.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={{ 'is-active': item.isActive, 'is-current': item.isExact }}
							aria-current={item.isExact ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<a class="header-call" href={SITE.phoneHref} aria-label={`Call ${SITE.name} at ${SITE.phoneDisplay}`}>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M7.2 3.5 10 8.1 8.2 10a15.4 15.4 0 0 0 5.8 5.8l1.9-1.8 4.6 2.8-.6 3.1c-.2.9-1 1.6-2 1.6C9.4 21 3 14.6 2.5 6.1c-.1-1 .6-1.8 1.6-2l3.1-.6Z"></path>
			</svg>
			<span><small>Reservations</small><strong>{SITE.phoneDisplay}</strong></span>
		</a>

		<a class="header-quote" href="/reserve/">Reserve Now</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-navigation"
			aria-label="Open navigation"
			data-menu-toggle
		>
			<span></span><span></span><span></span>
		</button>
	</div>

	<nav
		class="mobile-nav"
		id="mobile-navigation"
		aria-label="Mobile navigation"
		aria-hidden="true"
		data-mobile-nav
		inert
	>
		<ul>
			{navigation.map((item) => (
				<li>
					<a
						href={item.href}
						class:list={{ 'is-active': item.isActive, 'is-current': item.isExact }}
						aria-current={item.isExact ? 'page' : undefined}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
		<div class="mobile-nav__actions">
			<a class="mobile-quote" href="/reserve/">Reserve Now</a>
			<a class="mobile-phone" href={SITE.phoneHref}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7.2 3.5 10 8.1 8.2 10a15.4 15.4 0 0 0 5.8 5.8l1.9-1.8 4.6 2.8-.6 3.1c-.2.9-1 1.6-2 1.6C9.4 21 3 14.6 2.5 6.1c-.1-1 .6-1.8 1.6-2l3.1-.6Z"></path>
				</svg>
				Call {SITE.phoneDisplay}
			</a>
		</div>
	</nav>
</header>

<script>
	document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
		if (header.dataset.menuEnhanced === 'true') return;
		header.dataset.menuEnhanced = 'true';

		const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const mobileNav = header.querySelector<HTMLElement>('[data-mobile-nav]');
		if (!menuToggle || !mobileNav) return;

		const desktopBreakpoint = window.matchMedia('(min-width: 1181px)');

		const setMenuOpen = (open: boolean, restoreFocus = false) => {
			const wasOpen = menuToggle.getAttribute('aria-expanded') === 'true';
			menuToggle.setAttribute('aria-expanded', String(open));
			menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			mobileNav.setAttribute('aria-hidden', String(!open));
			mobileNav.inert = !open;
			header.classList.toggle('menu-is-open', open);
			document.body.classList.toggle('menu-open', open);

			if (open) {
				requestAnimationFrame(() => mobileNav.querySelector<HTMLAnchorElement>('a')?.focus());
			} else if (wasOpen && restoreFocus) {
				menuToggle.focus();
			}
		};

		const updateScrolledState = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
		updateScrolledState();
		window.addEventListener('scroll', updateScrolledState, { passive: true });

		menuToggle.addEventListener('click', () => {
			setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
		});

		mobileNav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
				setMenuOpen(false, true);
				return;
			}

			if (event.key !== 'Tab' || menuToggle.getAttribute('aria-expanded') !== 'true') return;
			const focusable = [
				menuToggle,
				...Array.from(mobileNav.querySelectorAll<HTMLElement>('a, button:not([disabled])')),
			];
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (!first || !last) return;

			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		desktopBreakpoint.addEventListener('change', (event) => {
			if (event.matches) setMenuOpen(false);
		});
	});
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		width: 100%;
		border-bottom: 1px solid transparent;
		transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.site-header--solid,
	.site-header.is-scrolled,
	.site-header.menu-is-open {
		border-bottom-color: rgba(255, 255, 255, 0.1);
		background: rgba(22, 23, 20, 0.97);
		box-shadow: 0 10px 36px rgba(0, 0, 0, 0.16);
		backdrop-filter: blur(14px);
	}

	.nav-shell {
		display: flex;
		align-items: center;
		gap: 18px;
		width: min(calc(100% - 40px), 1380px);
		height: var(--header-height);
		margin-inline: auto;
	}

	.brand {
		display: block;
		width: 196px;
		height: 65px;
		margin-right: auto;
	}

	.brand img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: left center;
	}

	.desktop-nav ul,
	.mobile-nav ul {
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.desktop-nav ul {
		display: flex;
		align-items: center;
		gap: clamp(11px, 1.15vw, 21px);
	}

	.desktop-nav a {
		position: relative;
		color: rgba(255, 255, 255, 0.86);
		font-size: clamp(0.67rem, 0.69vw, 0.78rem);
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;
		white-space: nowrap;
		transition: color 180ms ease;
	}

	.desktop-nav a::after {
		position: absolute;
		bottom: -8px;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--gold);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 180ms ease;
	}

	.desktop-nav a:hover,
	.desktop-nav a.is-active {
		color: var(--white);
	}

	.desktop-nav a:hover::after,
	.desktop-nav a.is-active::after {
		transform: scaleX(1);
	}

	.desktop-nav a.is-active:not(.is-current) {
		color: var(--gold-bright);
	}

	.header-call {
		display: flex;
		align-items: center;
		gap: 9px;
		color: var(--white);
		text-decoration: none;
		white-space: nowrap;
	}

	.header-call svg {
		width: 21px;
		height: 21px;
		color: var(--gold);
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.header-call span,
	.header-call small,
	.header-call strong {
		display: block;
	}

	.header-call small {
		color: rgba(255, 255, 255, 0.64);
		font-size: 0.52rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.header-call strong {
		font-size: 0.75rem;
		letter-spacing: 0.025em;
	}

	.header-quote,
	.mobile-quote,
	.mobile-phone {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 12px 20px;
		border: 1px solid transparent;
		border-radius: 3px;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.045em;
		line-height: 1.2;
		text-decoration: none;
		text-transform: uppercase;
	}

	.header-quote,
	.mobile-quote {
		background: var(--gold);
		color: var(--ink);
		box-shadow: 0 10px 30px rgba(247, 184, 23, 0.18);
		transition: background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
	}

	.header-quote:hover,
	.mobile-quote:hover {
		background: var(--gold-bright);
		box-shadow: 0 14px 34px rgba(247, 184, 23, 0.28);
		transform: translateY(-2px);
	}

	.menu-toggle,
	.mobile-nav {
		display: none;
	}

	@media (max-width: 1180px) {
		.desktop-nav,
		.header-call,
		.header-quote {
			display: none;
		}

		.menu-toggle {
			display: grid;
			place-content: center;
			gap: 5px;
			width: 48px;
			height: 48px;
			padding: 0;
			border: 1px solid rgba(255, 255, 255, 0.32);
			border-radius: 3px;
			background: rgba(255, 255, 255, 0.04);
			cursor: pointer;
		}

		.menu-toggle span {
			display: block;
			width: 21px;
			height: 1px;
			background: var(--white);
			transition: opacity 180ms ease, transform 180ms ease;
		}

		.menu-toggle[aria-expanded='true'] span:first-child {
			transform: translateY(6px) rotate(45deg);
		}

		.menu-toggle[aria-expanded='true'] span:nth-child(2) {
			opacity: 0;
		}

		.menu-toggle[aria-expanded='true'] span:last-child {
			transform: translateY(-6px) rotate(-45deg);
		}

		.mobile-nav {
			position: absolute;
			top: var(--header-height);
			left: 0;
			display: block;
			width: 100%;
			max-height: calc(100dvh - var(--header-height));
			padding: 24px max(24px, calc((100% - var(--max-width)) / 2));
			overflow-y: auto;
			border-top: 1px solid rgba(255, 255, 255, 0.1);
			background: rgba(22, 23, 20, 0.99);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-12px);
			visibility: hidden;
			transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
		}

		.site-header.menu-is-open .mobile-nav {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
			visibility: visible;
			transition-delay: 0s;
		}

		.mobile-nav li {
			border-bottom: 1px solid rgba(255, 255, 255, 0.09);
		}

		.mobile-nav li a {
			display: block;
			padding: 12px 2px;
			color: rgba(255, 255, 255, 0.84);
			font-size: 0.9rem;
			font-weight: 600;
			text-decoration: none;
		}

		.mobile-nav li a.is-active {
			color: var(--gold-bright);
		}

		.mobile-nav__actions {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
			margin-top: 20px;
		}

		.mobile-phone {
			gap: 8px;
			border-color: rgba(255, 255, 255, 0.5);
			background: rgba(255, 255, 255, 0.04);
			color: var(--white);
		}

		.mobile-phone svg {
			width: 19px;
			height: 19px;
			fill: none;
			stroke: currentColor;
			stroke-linecap: round;
			stroke-linejoin: round;
			stroke-width: 1.6;
		}
	}

	@media (max-width: 720px) {
		:global(:root) {
			--header-height: 74px;
		}

		.nav-shell {
			width: calc(100% - 28px);
		}

		.brand {
			width: 174px;
			height: 58px;
		}

		.menu-toggle {
			width: 44px;
			height: 44px;
		}
	}

	@media (max-width: 430px) {
		.mobile-nav__actions {
			grid-template-columns: 1fr;
		}
	}
</style>
