---
interface Props {
	eyebrow: string;
	title: string;
	accent?: string;
	description: string;
	image: string;
	imageAlt: string;
	compact?: boolean;
}

const { eyebrow, title, accent, description, image, imageAlt, compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact }]} aria-labelledby="page-heading">
	<img class="page-hero__image" src={image} alt={imageAlt} width="1920" height="1080" fetchpriority="high" />
	<div class="page-hero__overlay" aria-hidden="true"></div>
	<div class="page-hero__shell">
		<div class="page-hero__content">
			<p class="page-hero__eyebrow"><span></span>{eyebrow}</p>
			<h1 id="page-heading">{title}{accent && <Fragment> <em>{accent}</em></Fragment>}</h1>
			<p class="page-hero__description">{description}</p>
		</div>
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		display: grid;
		min-height: clamp(34rem, 61vw, 43rem);
		isolation: isolate;
		overflow: hidden;
		background: #10120f;
		color: #fff;
	}

	.page-hero--compact {
		min-height: clamp(29rem, 50vw, 36rem);
	}

	.page-hero__image,
	.page-hero__overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.page-hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: center;
	}

	.page-hero__overlay {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(4, 9, 12, 0.96) 0%, rgba(4, 9, 12, 0.84) 39%, rgba(4, 9, 12, 0.26) 75%, rgba(4, 9, 12, 0.08) 100%),
			linear-gradient(0deg, rgba(4, 9, 12, 0.34), transparent 48%);
	}

	.page-hero__shell {
		display: flex;
		align-items: center;
		width: min(calc(100% - 3rem), 77.5rem);
		margin: 0 auto;
		padding: calc(var(--header-height) + 1rem) 0 2rem;
	}

	.page-hero__content {
		min-width: 0;
		width: min(100%, 48rem);
	}

	.page-hero__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.35rem;
		color: #f7b817;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.19em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.page-hero__eyebrow span {
		width: 2rem;
		height: 1px;
		background: currentColor;
	}

	.page-hero h1 {
		max-width: 47rem;
		margin: 0;
		font-family: 'Libre Caslon Display', Georgia, serif;
		font-size: clamp(3.35rem, 7.2vw, 6.85rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.93;
		text-wrap: balance;
	}

	.page-hero h1 em {
		display: block;
		color: #f7b817;
		font-style: normal;
	}

	.page-hero__description {
		max-width: 39rem;
		margin: 1.65rem 0 0;
		color: rgba(255, 255, 255, 0.8);
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: clamp(1rem, 1.65vw, 1.17rem);
		line-height: 1.75;
	}

	@media (max-width: 50rem) {
		.page-hero,
		.page-hero--compact {
			min-height: 34rem;
		}

		.page-hero__overlay {
			background:
				linear-gradient(90deg, rgba(4, 9, 12, 0.94) 0%, rgba(4, 9, 12, 0.72) 72%, rgba(4, 9, 12, 0.38) 100%),
				linear-gradient(0deg, rgba(4, 9, 12, 0.48), transparent 60%);
		}

		.page-hero__shell {
			width: min(calc(100% - 2rem), 77.5rem);
		}

		.page-hero h1 {
			font-size: clamp(2.55rem, 11.5vw, 5rem);
		}
	}

	@media (max-width: 30rem) {
		.page-hero,
		.page-hero--compact {
			min-height: 31rem;
		}

		.page-hero__eyebrow {
			font-size: 0.65rem;
			letter-spacing: 0.15em;
		}

		.page-hero__description {
			font-size: 0.96rem;
			line-height: 1.65;
		}
	}
</style>
