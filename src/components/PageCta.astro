---
import { SITE } from '../config/site';

interface Props {
	eyebrow?: string;
	title: string;
	accent?: string;
	description: string;
	primaryHref?: string;
	primaryLabel?: string;
}

const {
	eyebrow = 'Ready when you are',
	title,
	accent,
	description,
	primaryHref = '/quote/',
	primaryLabel = 'Get a Quote',
} = Astro.props;
---

<section class="page-cta" aria-labelledby="page-cta-heading">
	<div class="page-cta__shell">
		<div class="page-cta__copy">
			<p class="page-cta__eyebrow"><span></span>{eyebrow}</p>
			<h2 id="page-cta-heading">{title}{accent && <Fragment> <em>{accent}</em></Fragment>}</h2>
			<p>{description}</p>
		</div>
		<div class="page-cta__actions">
			<a class="page-cta__primary" href={primaryHref}>
				{primaryLabel}
				<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg>
			</a>
			<a class="page-cta__secondary" href={SITE.phoneHref} aria-label={`Call Lester Pearson Limousine at ${SITE.phoneDisplay}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 10 8.1 8.2 10a15.4 15.4 0 0 0 5.8 5.8l1.9-1.8 4.6 2.8-.6 3.1c-.2.9-1 1.6-2 1.6C9.4 21 3 14.6 2.5 6.1c-.1-1 .6-1.8 1.6-2l3.1-.6Z" /></svg>
				Call {SITE.phoneDisplay}
			</a>
		</div>
	</div>
</section>

<style>
	.page-cta {
		background: #f7b817;
		color: #171815;
	}

	.page-cta__shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 3rem;
		width: min(calc(100% - 3rem), 77.5rem);
		margin: 0 auto;
		padding: clamp(3.75rem, 7vw, 6.25rem) 0;
	}

	.page-cta__copy {
		max-width: 45rem;
	}

	.page-cta__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1rem;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.page-cta__eyebrow span {
		width: 2rem;
		height: 1px;
		background: currentColor;
	}

	.page-cta h2 {
		margin: 0;
		font-family: 'Libre Caslon Display', Georgia, serif;
		font-size: clamp(2.55rem, 5vw, 4.75rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 1;
		text-wrap: balance;
	}

	.page-cta h2 em {
		font-style: italic;
	}

	.page-cta__copy > p:last-child {
		max-width: 39rem;
		margin: 1.15rem 0 0;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 1rem;
		line-height: 1.75;
	}

	.page-cta__actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 17.5rem;
	}

	.page-cta__actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		min-height: 3.75rem;
		padding: 0.9rem 1.35rem;
		border: 1px solid #171815;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.25;
		text-align: center;
		text-decoration: none;
		text-transform: uppercase;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.page-cta__actions svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.page-cta__primary {
		background: #171815;
		color: #fff;
	}

	.page-cta__secondary {
		background: transparent;
		color: #171815;
	}

	.page-cta__actions a:hover {
		transform: translateY(-2px);
	}

	.page-cta__primary:hover {
		background: #2b2d29;
	}

	.page-cta__secondary:hover {
		background: rgba(255, 255, 255, 0.38);
	}

	@media (max-width: 58rem) {
		.page-cta__shell {
			grid-template-columns: 1fr;
		}

		.page-cta__actions {
			flex-direction: row;
			min-width: 0;
		}

		.page-cta__actions a {
			flex: 1 1 0;
		}
	}

	@media (max-width: 38rem) {
		.page-cta__shell {
			width: min(calc(100% - 2rem), 77.5rem);
			gap: 2rem;
		}

		.page-cta__actions {
			flex-direction: column;
		}

		.page-cta__actions a {
			width: 100%;
		}
	}
</style>
