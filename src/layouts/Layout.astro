---
import { SITE } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	ogType?: 'website' | 'article';
	bodyClass?: string;
}

const {
	title = SITE.defaultTitle,
	description = SITE.defaultDescription,
	image,
	imageAlt,
	noindex = false,
	ogType = 'website',
	bodyClass,
} = Astro.props;

// Canonical and absolute social URLs are emitted only after a production `site`
// is configured in astro.config.mjs. This avoids publishing localhost URLs.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang={SITE.language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#171815" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		{socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Caslon+Display&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--gold: #f7b817;
		--gold-bright: #ffc62d;
		--gold-deep: #d79b08;
		--charcoal: #242522;
		--ink: #171815;
		--slate: #5f625e;
		--stone: #ece9e1;
		--ivory: #f8f6f0;
		--white: #ffffff;
		--line: rgba(23, 24, 21, 0.12);
		--shadow-soft: 0 18px 60px rgba(22, 23, 20, 0.1);
		--shadow-card: 0 24px 70px rgba(22, 23, 20, 0.14);
		--font-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		--font-display: 'Libre Caslon Display', Georgia, serif;
		--max-width: 1240px;
		--header-height: 84px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 96px;
	}

	body {
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background: var(--ivory);
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 16px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	body.menu-open {
		overflow: hidden;
	}

	img,
	picture,
	svg {
		display: block;
		max-width: 100%;
	}

	button,
	input,
	select,
	textarea {
		font: inherit;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	a {
		color: inherit;
	}

	::selection {
		background: var(--gold);
		color: var(--ink);
	}

	:focus-visible {
		outline: 3px solid var(--gold-bright);
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
</style>
