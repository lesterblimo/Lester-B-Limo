---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const phoneDisplay = '(437) 967-5262';
const phoneHref = 'tel:+14379675262';
const emailAddress = 'lesterb.limo@gmail.com';
const ArrowIcon = `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const PhoneIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 10 8.1 8.2 10a15.4 15.4 0 0 0 5.8 5.8l1.9-1.8 4.6 2.8-.6 3.1c-.2.9-1 1.6-2 1.6C9.4 21 3 14.6 2.5 6.1c-.1-1 .6-1.8 1.6-2l3.1-.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const reviews = [
	{
		name: 'aleem',
		initials: 'A',
		date: '',
		rating: 5,
		text: 'this was my second time riding with this company and i will be coming back! they were amazing, the driver was friendly, and the SUV was completely clean. Highly recommend',
	},
	{
		name: 'Michael R.',
		initials: 'MR',
		date: '',
		rating: null,
		text: 'Great service from start to finish. The SUV was clean, comfortable, and on time. Driver was professional and made the airport ride easy. Would definitely use them again.',
	},
	{
		name: 'David M.',
		initials: 'DM',
		date: '',
		rating: null,
		text: 'Very reliable and professional service. The SUV was spotless, the driver was on time, and the ride to the airport was smooth and comfortable. Highly recommend.',
	},
];
---

<Layout bodyClass="has-mobile-call-bar" image="/images/hero-cadillac-escalade-road.webp" imageAlt="Black Cadillac Escalade driving along a tree-lined road">
	<a class="skip-link" href="#main-content">Skip to main content</a>
	<SiteHeader />

	<main id="main-content">
		<section class="hero" id="home" aria-labelledby="hero-heading">
			<picture>
				<source media="(max-width: 720px)" srcset="/images/hero-cadillac-escalade-mobile.webp" type="image/webp" />
				<img
					class="hero__image"
					src="/images/hero-cadillac-escalade-road.webp"
					alt="Black Cadillac Escalade driving along a tree-lined road"
					width="1916"
					height="821"
					fetchpriority="high"
				/>
			</picture>
			<div class="hero__veil"></div>
			<div class="section-shell hero__inner">
				<div class="hero__content">
					<p class="eyebrow eyebrow--light"><span></span>Private chauffeur service</p>
					<h1 id="hero-heading">Executive Transportation <em>Without Compromise</em></h1>
				</div>
			</div>
			<a class="scroll-cue" href="#quote" aria-label="Scroll to quote form">
				<span>Plan your ride</span>
				<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13m-5-5 5 5 5-5" /></svg>
			</a>
		</section>

		<section class="quote-section" id="quote" aria-labelledby="quote-heading">
			<div class="section-shell">
				<div class="quote-actions" aria-label="Quote contact options">
					<a class="button button--gold button--large" href="#quote-form">
						Get a Quote <Fragment set:html={ArrowIcon} />
					</a>
					<a class="button button--ghost button--large" href={phoneHref}><Fragment set:html={PhoneIcon} /> Call {phoneDisplay}</a>
				</div>
				<div class="quote-card">
					<div class="quote-card__header">
						<div>
							<p class="eyebrow"><span></span>Request a personalized quote</p>
							<h2 id="quote-heading">Where Can We Take You?</h2>
						</div>
						<ol class="form-steps" aria-label="Quote request progress">
							<li class="is-active" data-step-marker="1" aria-current="step">
								<span>1</span><small>Trip</small>
							</li>
							<li data-step-marker="2"><span>2</span><small>Contact</small></li>
						</ol>
					</div>
					<form class="quote-form" id="quote-form" data-quote-form data-email={emailAddress} novalidate>
						<div class="form-panel" data-form-step="1">
							<div class="form-grid">
								<label class="field">
									<span>Trip Type</span>
									<select name="tripType" required>
										<option value="">Select trip type</option>
										<option>One Way</option>
										<option>Round Trip</option>
										<option>Hourly Service</option>
										<option>Airport Transfer</option>
									</select>
								</label>

								<label class="field field--wide">
									<span>Pickup Location</span>
									<span class="input-wrap">
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
										<input name="pickup" type="text" placeholder="Address, airport, or hotel" autocomplete="street-address" required />
									</span>
								</label>

								<label class="field field--wide">
									<span>Drop-Off Location</span>
									<span class="input-wrap">
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
										<input name="dropoff" type="text" placeholder="Where are you headed?" required />
									</span>
								</label>

								<label class="field">
									<span>Pickup Date</span>
									<input name="pickupDate" type="date" required data-pickup-date />
								</label>

								<label class="field">
									<span>Pickup Time</span>
									<input name="pickupTime" type="time" required />
								</label>

								<label class="field">
									<span>Passengers</span>
									<input name="passengers" type="number" inputmode="numeric" min="1" max="14" placeholder="1" required />
								</label>

								<label class="field">
									<span>Vehicle Preference</span>
									<select name="vehicle" required>
										<option value="">Select vehicle</option>
										<option>Executive Sedan</option>
										<option>Executive SUV</option>
										<option>Executive Sprinter</option>
										<option>Recommend for Me</option>
									</select>
								</label>
							</div>

							<div class="form-actions form-actions--end">
								<p><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2 4 4.5v4.8c0 3.9 2.5 6.8 6 8.7 3.5-1.9 6-4.8 6-8.7V4.5L10 2Z"/><path d="m7.5 10 1.6 1.6 3.5-3.7"/></svg>Your trip details stay private.</p>
								<button class="button button--gold button--large" type="button" data-next-step>
									Next Step <Fragment set:html={ArrowIcon} />
								</button>
							</div>
						</div>

						<div class="form-panel" data-form-step="2" hidden>
							<div class="form-grid form-grid--contact">
								<label class="field">
									<span>Return Details <small>Optional</small></span>
									<input name="returnDetails" type="text" placeholder="Return date and time" />
								</label>
								<label class="field">
									<span>Number of Bags <small>Optional</small></span>
									<input name="bags" type="number" inputmode="numeric" min="0" max="30" placeholder="0" />
								</label>
								<label class="field">
									<span>Name</span>
									<input name="name" type="text" autocomplete="name" placeholder="Your full name" required />
								</label>
								<label class="field">
									<span>Phone</span>
									<input name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" required />
								</label>
								<label class="field field--wide">
									<span>Email</span>
									<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
								</label>
								<label class="field field--full">
									<span>Additional Notes <small>Optional</small></span>
									<textarea name="notes" rows="3" placeholder="Flight number, child seats, accessibility needs, or anything else we should know"></textarea>
								</label>
							</div>
							<div class="form-actions">
								<button class="text-button" type="button" data-prev-step>
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H5m4-4-4 4 4 4" /></svg>
									Back to trip details
								</button>
								<div class="submit-wrap">
									<button class="button button--gold button--large" type="submit">Submit Quote Request <Fragment set:html={ArrowIcon} /></button>
									<small>Submitting opens your email app.</small>
								</div>
							</div>
						</div>
						<p class="form-status" data-form-status role="status" tabindex="-1" hidden>
							Your email app should open with your quote details. If it does not, email us directly at {emailAddress}.
						</p>
					</form>
				</div>
			</div>
		</section>

		<section class="fleet section" id="fleet" aria-labelledby="fleet-heading">
			<div class="section-shell">
				<div class="section-heading section-heading--split">
					<div>
						<p class="eyebrow"><span></span>Our fleet</p>
						<h2 id="fleet-heading">Choose Your Ride</h2>
					</div>
				</div>

				<div class="fleet-grid">
					<article class="fleet-card">
						<div class="fleet-card__media">
							<img src="/images/fleet-chrysler-300-sedan.webp" alt="Black Chrysler 300 executive sedan" width="1600" height="904" loading="lazy" />
							<span class="capacity-badge"><strong>4</strong> passengers</span>
						</div>
						<div class="fleet-card__body">
							<h3>Executive Sedan</h3>
							<p>A refined executive sedan offering a quiet ride, leather seating, and professional transportation for airport transfers, corporate travel, and private service.</p>
							<ul class="attribute-list">
								<li>Up to 4 passengers</li><li>Premium leather interior</li><li>Quiet, private cabin</li><li>Airport &amp; corporate travel</li>
							</ul>
							<a class="arrow-link" href="/fleet/executive-sedan/">View Executive Sedan <Fragment set:html={ArrowIcon} /></a>
						</div>
					</article>

					<article class="fleet-card">
						<div class="fleet-card__media">
							<img src="/images/fleet-chevrolet-suburban-2025.avif" alt="Black 2025 Chevrolet Suburban" width="768" height="450" loading="lazy" />
							<span class="capacity-badge"><strong>6</strong> passengers</span>
						</div>
						<div class="fleet-card__body">
							<h3>Full-Size Executive SUV</h3>
							<p>Premium full-size SUVs offering comfort, privacy, luggage capacity, and professional transportation for airport transfers, corporate travel, and private service.</p>
							<ul class="attribute-list">
								<li>Up to 6 passengers</li><li>Premium leather interior</li><li>Spacious luggage capacity</li><li>Airport & corporate travel</li>
							</ul>
							<a class="arrow-link" href="/fleet/executive-suv/">View Executive SUV <Fragment set:html={ArrowIcon} /></a>
						</div>
					</article>

					<article class="fleet-card">
						<div class="fleet-card__media">
							<img src="/images/fleet-mercedes-sprinter-black.webp" alt="Black Mercedes-Benz Sprinter passenger van" width="1219" height="889" loading="lazy" />
							<span class="capacity-badge capacity-badge--dark"><strong>12–14</strong> passengers</span>
						</div>
						<div class="fleet-card__body">
							<h3>Executive Sprinter</h3>
							<p>Premium group transportation with spacious front-facing seating, generous luggage capacity, and a comfortable high-roof cabin.</p>
							<ul class="attribute-list">
								<li>Front-facing seating</li><li>Premium passenger interior</li><li>High-roof cabin</li><li>Large luggage capacity</li>
							</ul>
							<a class="arrow-link" href="/fleet/executive-sprinter/">View Executive Sprinter <Fragment set:html={ArrowIcon} /></a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="airport section" id="airport" aria-labelledby="airport-heading">
			<div class="section-shell airport-grid">
				<div class="airport__heading">
					<p class="eyebrow"><span></span>Airport transportation</p>
					<h2 id="airport-heading">Airport Transportation <em>Made Simple</em></h2>
				</div>
				<div class="airport__media">
					<img src="/images/airport-business-travelers-real.jpg" alt="Two business travelers walking through an airport terminal with luggage" width="1920" height="1280" loading="lazy" />
					<div class="airport-note"><span>YYZ</span><p>Airport pickup<br /><strong>planned around you</strong></p></div>
				</div>
				<div class="airport__content">
					<p class="section-copy">From a scheduled pickup to the final drop-off, every detail is coordinated for a quieter, more comfortable airport transfer.</p>
					<ul class="check-grid">
						<li>Scheduled airport pickups</li><li>Flight-aware service</li><li>Professional chauffeurs</li><li>Meet-and-greet availability</li><li>Executive SUVs</li><li>Executive Sprinter service</li><li>Luggage-friendly vehicles</li><li>Private transportation</li>
					</ul>
					<div class="cta-pair">
						<a class="button button--dark button--large" href="/quote/?service=airport-transportation">Request Airport Transportation <Fragment set:html={ArrowIcon} /></a>
						<a class="phone-text-link" href={phoneHref}><Fragment set:html={PhoneIcon} /><span>Call for airport service<strong>{phoneDisplay}</strong></span></a>
					</div>
				</div>
			</div>
		</section>

		<section class="corporate section" id="corporate" aria-labelledby="corporate-heading">
			<div class="corporate__pattern" aria-hidden="true"></div>
			<div class="section-shell corporate__inner">
				<div class="corporate__label"><span>Executive<br />service</span><strong>Built around<br />your calendar.</strong></div>
				<div class="corporate__content">
					<p class="eyebrow eyebrow--light"><span></span>Corporate transportation</p>
					<h2 id="corporate-heading">Transportation <em>Built for Business</em></h2>
					<p>From executive airport transfers to conferences and corporate events, Lester Pearson Limousine provides professional transportation designed around your schedule.</p>
					<div class="cta-pair">
						<a class="button button--gold button--large" href="/quote/?service=corporate-transportation">Corporate Transportation <Fragment set:html={ArrowIcon} /></a>
						<a class="phone-text-link phone-text-link--light" href={phoneHref}><Fragment set:html={PhoneIcon} /><span>Call our team<strong>{phoneDisplay}</strong></span></a>
					</div>
				</div>
			</div>
			<div class="section-shell corporate-more" aria-labelledby="more-services-heading">
				<div class="corporate-more__heading">
					<p class="eyebrow eyebrow--light"><span></span>More ways to ride</p>
					<h3 id="more-services-heading">Explore More Services</h3>
				</div>
				<div class="corporate-more__grid">
					<a class="corporate-service" href="/services/private-transportation/">
						<span class="corporate-service__number">01</span>
						<span><strong>Private Transportation</strong><small>Discreet, door-to-door travel built around your plans.</small></span>
						<Fragment set:html={ArrowIcon} />
					</a>
					<a class="corporate-service" href="/services/group-transportation/">
						<span class="corporate-service__number">02</span>
						<span><strong>Group Transportation</strong><small>Coordinated premium travel for groups of every size.</small></span>
						<Fragment set:html={ArrowIcon} />
					</a>
					<a class="corporate-service" href="/services/weddings-special-events/">
						<span class="corporate-service__number">03</span>
						<span><strong>Weddings & Special Events</strong><small>Polished arrivals for moments worth remembering.</small></span>
						<Fragment set:html={ArrowIcon} />
					</a>
					<a class="corporate-service" href="/services/hourly-chauffeur/">
						<span class="corporate-service__number">04</span>
						<span><strong>Hourly Chauffeur Service</strong><small>A professional vehicle and chauffeur on your schedule.</small></span>
						<Fragment set:html={ArrowIcon} />
					</a>
				</div>
				<a class="corporate-more__all" href="/services/">View all services <Fragment set:html={ArrowIcon} /></a>
			</div>
		</section>

		<section class="testimonials section" aria-labelledby="testimonials-heading">
			<div class="section-shell">
				<div class="section-heading section-heading--split">
					<div><p class="eyebrow"><span></span>Client reviews</p><h2 id="testimonials-heading">What Our Clients <em>Are Saying</em></h2></div>
					<div class="review-summary" aria-label="5 star reviews">
						<span class="review-stars" aria-hidden="true">★★★★★</span>
						<strong>5 Star Reviews</strong>
					</div>
				</div>

				<div class="review-carousel" data-review-carousel role="region" aria-roledescription="carousel" aria-label="Client reviews" tabindex="0">
					<div class="review-carousel__viewport">
						<div class="review-carousel__track" data-review-track>
							{reviews.map((review, index) => (
								<article class="review-card" data-review-slide aria-label={`Review ${index + 1} of ${reviews.length}`} aria-hidden={index === 0 ? 'false' : 'true'}>
									<div class="review-card__top">
										{review.rating ? <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}><span aria-hidden="true">★★★★★</span></span> : <span class="review-card__label">Client review</span>}
										{review.date && <time>{review.date}</time>}
									</div>
									<blockquote><p>{review.text}</p></blockquote>
									<footer class="review-author">
										<span class="review-avatar" aria-hidden="true">{review.initials}</span>
										<p><strong>{review.name}</strong></p>
									</footer>
								</article>
							))}
						</div>
					</div>

					<div class="review-carousel__footer">
						<div class="review-carousel__controls">
							<button type="button" data-review-prev aria-label="Show previous review"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button>
							<p aria-live="polite"><strong data-review-current>1</strong><span>/</span><span>{reviews.length}</span></p>
							<button type="button" data-review-next aria-label="Show next review"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
						</div>
						<div class="review-carousel__dots" aria-label="Choose a review">
							{reviews.map((review, index) => <button type="button" data-review-dot={index} aria-label={`Show review by ${review.name}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="final-cta" aria-labelledby="cta-heading">
			<div class="section-shell final-cta__inner">
				<div><p class="eyebrow"><span></span>Ready when you are</p><h2 id="cta-heading">Your Ride Should Be <em>the Easy Part.</em></h2><p>Tell us where you're going and we'll help arrange the right vehicle for your trip.</p></div>
				<div class="final-cta__actions"><a class="button button--dark button--large" href="/quote/">Get a Quote <Fragment set:html={ArrowIcon} /></a><a class="button button--outline-dark button--large" href={phoneHref}><Fragment set:html={PhoneIcon} /> Call {phoneDisplay}</a></div>
			</div>
		</section>
	</main>
	<SiteFooter />

	<script>
		const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
		const firstStep = document.querySelector<HTMLElement>('[data-form-step="1"]');
		const secondStep = document.querySelector<HTMLElement>('[data-form-step="2"]');
		const nextButton = document.querySelector<HTMLButtonElement>('[data-next-step]');
		const previousButton = document.querySelector<HTMLButtonElement>('[data-prev-step]');
		const status = document.querySelector<HTMLElement>('[data-form-status]');
		const pickupDate = document.querySelector<HTMLInputElement>('[data-pickup-date]');

		if (pickupDate) {
			const localToday = new Date();
			localToday.setMinutes(localToday.getMinutes() - localToday.getTimezoneOffset());
			pickupDate.min = localToday.toISOString().split('T')[0];
		}

		const showStep = (step: 1 | 2) => {
			if (!firstStep || !secondStep) return;
			firstStep.hidden = step !== 1;
			secondStep.hidden = step !== 2;
			document.querySelectorAll('[data-step-marker]').forEach((marker) => {
				const active = marker.getAttribute('data-step-marker') === String(step);
				marker.classList.toggle('is-active', active);
				if (active) marker.setAttribute('aria-current', 'step');
				else marker.removeAttribute('aria-current');
			});
		};

		nextButton?.addEventListener('click', () => {
			if (!firstStep) return;
			const requiredFields = Array.from(firstStep.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
			const invalidField = requiredFields.find((field) => !field.checkValidity());
			if (invalidField) {
				invalidField.reportValidity();
				return;
			}
			showStep(2);
			secondStep?.querySelector<HTMLInputElement>('input')?.focus();
		});

		previousButton?.addEventListener('click', () => {
			showStep(1);
			nextButton?.focus();
		});

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			if (status) {
				status.hidden = false;
				status.focus();
			}

			const email = form.dataset.email;
			if (!email) return;
			const details = Array.from(new FormData(form).entries())
				.filter(([, value]) => String(value).trim())
				.map(([key, value]) => `${key.replace(/([A-Z])/g, ' $1').replace(/^./, (letter) => letter.toUpperCase())}: ${value}`)
				.join('\n');
			window.location.href = `mailto:${email}?subject=${encodeURIComponent('Transportation quote request')}&body=${encodeURIComponent(details)}`;
		});

		const reviewCarousel = document.querySelector<HTMLElement>('[data-review-carousel]');
		const reviewTrack = reviewCarousel?.querySelector<HTMLElement>('[data-review-track]');
		const reviewSlides = Array.from(reviewCarousel?.querySelectorAll<HTMLElement>('[data-review-slide]') ?? []);
		const reviewDots = Array.from(reviewCarousel?.querySelectorAll<HTMLButtonElement>('[data-review-dot]') ?? []);
		const reviewCurrent = reviewCarousel?.querySelector<HTMLElement>('[data-review-current]');
		let activeReview = 0;

		const showReview = (index: number) => {
			if (!reviewTrack || reviewSlides.length === 0) return;
			activeReview = (index + reviewSlides.length) % reviewSlides.length;
			reviewTrack.style.transform = `translateX(-${activeReview * 100}%)`;
			reviewSlides.forEach((slide, slideIndex) => slide.setAttribute('aria-hidden', String(slideIndex !== activeReview)));
			reviewDots.forEach((dot, dotIndex) => dot.setAttribute('aria-current', String(dotIndex === activeReview)));
			if (reviewCurrent) reviewCurrent.textContent = String(activeReview + 1);
		};

		reviewCarousel?.querySelector('[data-review-prev]')?.addEventListener('click', () => showReview(activeReview - 1));
		reviewCarousel?.querySelector('[data-review-next]')?.addEventListener('click', () => showReview(activeReview + 1));
		reviewDots.forEach((dot) => dot.addEventListener('click', () => showReview(Number(dot.dataset.reviewDot))));
		reviewCarousel?.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				showReview(activeReview - 1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				showReview(activeReview + 1);
			}
		});

		let reviewTouchStartX = 0;
		reviewCarousel?.addEventListener('touchstart', (event) => {
			reviewTouchStartX = event.changedTouches[0]?.clientX ?? 0;
		}, { passive: true });
		reviewCarousel?.addEventListener('touchend', (event) => {
