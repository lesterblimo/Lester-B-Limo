				padding-block: 60px;
			}

			.hero {
				min-height: 760px;
			}

			.hero__image {
				object-position: 62% center;
			}

			.hero__content {
				max-width: 600px;
			}

			.scroll-cue {
				display: none;
			}

			.quote-card {
				padding: 38px 34px;
			}

			.field,
			.field--wide {
				grid-column: span 12;
			}

			.fleet-grid,
			.airport-grid,
			.corporate__inner {
				grid-template-columns: 1fr;
			}

			.fleet-grid {
				gap: 34px;
			}

			.airport-grid {
				grid-template-areas:
					'media'
					'heading'
					'content';
				gap: 0;
			}

			.airport__heading {
				margin-top: 70px;
			}

			.airport__media img {
				height: 490px;
			}

			.corporate__label {
				display: none;
			}

			.corporate__content {
				max-width: 760px;
			}

			.final-cta__inner {
				grid-template-columns: 1fr;
				gap: 34px;
			}

			.final-cta__actions {
				justify-self: start;
			}

			.footer__top {
				grid-template-columns: 1.25fr repeat(2, 0.9fr);
			}

			.footer__contact {
				grid-column: 2 / -1;
			}
		}

		@media (max-width: 720px) {
			:global(:root) {
				--header-height: 74px;
			}

			.section-shell {
				width: min(calc(100% - 32px), var(--max-width));
