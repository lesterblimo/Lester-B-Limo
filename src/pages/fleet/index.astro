---
import PageCta from '../../components/PageCta.astro';
import { fleet } from '../../data/fleet';
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
	title="Executive SUV & Sprinter Fleet | Lester Pearson Limousine"
	description="Explore Lester Pearson Limousine's Full-Size Executive SUV and Executive Sprinter for private, airport, corporate, and group transportation."
	headerVariant="solid"
>
	<Fragment>
		<section class="fleet-intro" aria-labelledby="fleet-intro-heading">
			<div class="page-shell">
				<header class="fleet-intro__heading">
					<p class="eyebrow"><span></span>Executive transportation<span></span></p>
					<h1 id="fleet-intro-heading">
						<span>Comfort for one trip.</span>
						<em>Space for the next.</em>
					</h1>
				</header>
			</div>
		</section>

		<section class="vehicle-directory" aria-label="Available vehicle types">
			<div class="page-shell vehicle-list">
				{fleet.map((vehicle, index) => (
					<article class:list={['vehicle-card', { 'vehicle-card--reverse': index % 2 === 1 }]} id={vehicle.slug}>
						<a class="vehicle-card__overlay" href={`/fleet/${vehicle.slug}/`} aria-label={`Explore ${vehicle.name}`} aria-hidden="true" tabindex="-1"></a>
						<div class="vehicle-card__media">
							<img
								src={vehicle.image}
								alt={vehicle.imageAlt}
								width={vehicle.imageWidth}
								height={vehicle.imageHeight}
								loading="lazy"
							/>
							<span>{vehicle.capacityShort}</span>
						</div>
						<div class="vehicle-card__content">
							<p class="vehicle-card__index">{String(index + 1).padStart(2, '0')} / {String(fleet.length).padStart(2, '0')}</p>
							<h2>{vehicle.name}</h2>
							<ul>
								{vehicle.attributes.slice(0, 4).map((attribute) => <li><span aria-hidden="true">✓</span>{attribute}</li>)}
							</ul>
							<div class="vehicle-card__actions">
								<a class="vehicle-card__primary" href={`/fleet/${vehicle.slug}/`}>
									Explore vehicle
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg>
								</a>
								<a class="vehicle-card__secondary" href={vehicle.quoteHref}>Request a quote</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="fleet-fit" aria-labelledby="fleet-fit-heading">
			<div class="page-shell fleet-fit__grid">
				<div>
					<p class="eyebrow eyebrow--light"><span></span>Choose around the trip</p>
					<h2 id="fleet-fit-heading">The right amount of <em>room and comfort.</em></h2>
				</div>
				<div class="fleet-fit__options">
					<article>
						<span>Up to 6</span>
						<h3>Executive SUV</h3>
						<p>Private transportation for airport transfers, corporate travel, and personal service.</p>
					</article>
					<article>
						<span>12–14</span>
						<h3>Executive Sprinter</h3>
						<p>Front-facing seating and a spacious high-roof cabin for group transportation.</p>
					</article>
				</div>
			</div>
		</section>

		<PageCta
			eyebrow="Choose your vehicle"
			title="Have a trip"
			accent="in mind?"
			description="Share the passenger count, luggage needs, and trip details to request the vehicle that fits."
			primaryHref="/quote/"
			primaryLabel="Request a Quote"
		/>
	</Fragment>
</SiteLayout>

<style>
	.page-shell {
		width: min(calc(100% - 3rem), 77.5rem);
		margin: 0 auto;
	}

	.fleet-intro,
	.vehicle-directory {
		background: #f8f6f0;
		color: #171815;
	}

	.fleet-intro {
		padding: clamp(3.25rem, 6vw, 5.25rem) 0 clamp(3.75rem, 7vw, 6rem);
	}

	.fleet-intro__heading {
		position: relative;
		padding-bottom: clamp(2rem, 4vw, 3.25rem);
		border-bottom: 1px solid rgba(23, 24, 21, 0.16);
		text-align: center;
	}

	.fleet-intro__heading .eyebrow {
		justify-content: center;
	}

	.fleet-intro__heading::after {
		position: absolute;
		bottom: -1px;
		left: 50%;
		width: clamp(5rem, 10vw, 8.5rem);
		height: 2px;
		background: #d99d08;
		content: '';
		transform: translateX(-50%);
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.2rem;
		color: #9a6b00;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.eyebrow span {
		width: 2rem;
		height: 1px;
		background: #d99d08;
	}

	.eyebrow--light {
		color: #f7b817;
	}

	.fleet-intro h1,
	.fleet-fit h2 {
		max-width: 67rem;
		margin: 0 auto;
		font-family: 'Libre Caslon Display', Georgia, serif;
		font-size: clamp(3.1rem, 6.25vw, 6rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.94;
		text-wrap: balance;
	}

	.fleet-intro h1 span,
	.fleet-intro h1 em {
		display: block;
	}

	.fleet-intro h1 em,
	.fleet-fit h2 em {
		color: #9a6b00;
		font-style: normal;
	}

	.fleet-intro h1 em {
		margin-top: 0.12em;
	}

	.vehicle-directory {
		padding: 0 0 clamp(5.5rem, 10vw, 9rem);
	}

	.vehicle-list {
		display: grid;
		gap: clamp(5rem, 10vw, 9rem);
	}

	.vehicle-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(21rem, 0.88fr);
		align-items: stretch;
		gap: clamp(2.5rem, 5vw, 5rem);
		min-width: 0;
		scroll-margin-top: 7rem;
		cursor: pointer;
	}

	.vehicle-card__overlay {
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.vehicle-card:focus-within {
		outline: 2px solid #d99d08;
		outline-offset: 0.35rem;
	}

	.vehicle-card--reverse {
		grid-template-columns: minmax(21rem, 0.88fr) minmax(0, 1.12fr);
	}

	.vehicle-card--reverse .vehicle-card__media {
		grid-column: 2;
		grid-row: 1;
	}

	.vehicle-card--reverse .vehicle-card__content {
		grid-column: 1;
		grid-row: 1;
	}

	.vehicle-card__media {
		position: relative;
		overflow: hidden;
		padding: clamp(0.45rem, 0.8vw, 0.7rem);
		border: 1px solid rgba(23, 24, 21, 0.1);
		background: #fff;
		box-shadow: 0 1.25rem 3.5rem rgba(23, 24, 21, 0.1);
	}

	.vehicle-card__media img {
		display: block;
		width: 100%;
		height: auto;
	}

	.vehicle-card__media > span {
		position: absolute;
		right: clamp(1.1rem, 2vw, 1.6rem);
		bottom: clamp(1.1rem, 2vw, 1.6rem);
		z-index: 1;
		padding: 0.75rem 1rem;
		background: #f7b817;
		box-shadow: 0 0.6rem 1.5rem rgba(23, 24, 21, 0.18);
		color: #171815;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.vehicle-card__content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
		padding: clamp(1.75rem, 2.5vw, 2rem);
		border: 1px solid rgba(23, 24, 21, 0.08);
		background: #fff;
		box-shadow: 0 1.25rem 3.5rem rgba(23, 24, 21, 0.08);
	}

	.vehicle-card__content::before {
		position: absolute;
		top: -1px;
		left: clamp(1.75rem, 2.5vw, 2rem);
		width: 4.5rem;
		height: 3px;
		background: #d99d08;
		content: '';
	}

	.vehicle-card__index {
		align-self: flex-start;
		padding: 0.36rem 0.6rem;
		margin: 0 0 0.75rem;
		background: #fff8e7;
		color: #9a6b00;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.vehicle-card h2 {
		margin: 0;
		font-family: 'Libre Caslon Display', Georgia, serif;
		font-size: clamp(2.2rem, 3.2vw, 3.15rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.vehicle-card ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		margin: 1rem 0 1.15rem;
		padding: 0;
		border-top: 1px solid rgba(23, 24, 21, 0.12);
		list-style: none;
	}

	.vehicle-card li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid rgba(23, 24, 21, 0.12);
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.75rem;
	}

	.vehicle-card li:nth-child(even) {
		padding-left: 0.8rem;
	}

	.vehicle-card li span {
		color: #b27b00;
		font-weight: 700;
	}

	.vehicle-card__actions {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.vehicle-card__actions a {
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.vehicle-card__primary {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 3rem;
		padding: 0.8rem 1.2rem;
		background: #171815;
		color: #fff;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.vehicle-card__primary:hover {
		background: #d99d08;
		color: #171815;
		transform: translateY(-2px);
	}

	.vehicle-card__primary svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.vehicle-card__secondary {
		padding-bottom: 0.25rem;
		border-bottom: 1px solid #d99d08;
		color: #171815;
		transition: border-color 180ms ease, color 180ms ease;
	}

	.vehicle-card__secondary:hover {
		border-color: #171815;
		color: #9a6b00;
	}

	.fleet-fit {
		padding: clamp(5rem, 9vw, 8rem) 0;
		background: #171815;
		color: #fff;
	}

	.fleet-fit__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
		align-items: center;
		gap: clamp(3rem, 9vw, 8rem);
	}

	.fleet-fit h2 em {
		color: #f7b817;
	}

	.fleet-fit__options {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid rgba(255, 255, 255, 0.16);
		border-left: 1px solid rgba(255, 255, 255, 0.16);
	}

	.fleet-fit__options article {
		min-height: 20rem;
		padding: clamp(1.75rem, 3vw, 2.5rem);
		border-right: 1px solid rgba(255, 255, 255, 0.16);
		border-bottom: 1px solid rgba(255, 255, 255, 0.16);
	}

	.fleet-fit__options span {
		display: block;
		margin-bottom: 4.5rem;
		color: #f7b817;
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.fleet-fit__options h3 {
		margin: 0;
		font-family: 'Libre Caslon Display', Georgia, serif;
		font-size: clamp(1.8rem, 3vw, 2.7rem);
		font-weight: 400;
		line-height: 1.05;
	}

	.fleet-fit__options p {
		margin: 1rem 0 0;
		color: rgba(255, 255, 255, 0.64);
		font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
		font-size: 0.86rem;
		line-height: 1.7;
	}

	@media (max-width: 65rem) {
		.vehicle-card,
		.vehicle-card--reverse {
			grid-template-columns: 1fr 1fr;
		}

		.fleet-fit__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 50rem) {
		.vehicle-card,
		.vehicle-card--reverse {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		.vehicle-card--reverse .vehicle-card__media,
		.vehicle-card--reverse .vehicle-card__content {
			grid-column: 1;
			grid-row: auto;
		}

	}

	@media (max-width: 38rem) {
		.page-shell {
			width: min(calc(100% - 2rem), 77.5rem);
		}

		.fleet-intro h1 {
			font-size: clamp(2.55rem, 12vw, 3.25rem);
		}

		.fleet-intro__heading .eyebrow {
			gap: 0.55rem;
			font-size: 0.62rem;
			letter-spacing: 0.14em;
		}

		.fleet-intro__heading .eyebrow span {
			width: 1.25rem;
		}

		.vehicle-card ul,
		.fleet-fit__options {
			grid-template-columns: 1fr;
		}

		.vehicle-card li:nth-child(even) {
			padding-left: 0;
		}

		.vehicle-card__actions {
			align-items: stretch;
			flex-direction: column;
		}

		.vehicle-card__primary {
			justify-content: center;
		}
	}
</style>
